rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidItem(data) {
      return data.keys().hasAll(['sku', 'namaBarang', 'quantity', 'hargaModal']) &&
        data.sku is string && data.sku.size() > 0 && data.sku.size() <= 100 &&
        data.namaBarang is string && data.namaBarang.size() > 0 && data.namaBarang.size() <= 200 &&
        data.quantity is number && data.quantity >= 0 &&
        data.hargaModal is number && data.hargaModal >= 0;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'role']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.role is string && data.role.size() > 0 && data.role.size() <= 100;
    }

    function isValidLog(data) {
      return data.keys().hasAll(['sku', 'namaBarang', 'user', 'action', 'newQty', 'timestamp']) &&
        data.sku is string && data.sku.size() <= 100 &&
        data.namaBarang is string && data.namaBarang.size() <= 200 &&
        data.user is string && data.user.size() <= 100 &&
        data.action is string && data.action.size() <= 50 &&
        data.newQty is number &&
        data.timestamp is string && data.timestamp.size() <= 50;
    }

    // Items collection for inventory opname
    match /items/{itemId} {
      allow read: if true;
      allow create: if isValidId(itemId) && isValidItem(incoming());
      allow update: if isValidId(itemId) && isValidItem(incoming());
      allow delete: if isValidId(itemId);
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isValidId(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if isValidId(userId);
    }

    // Audit logs collection (append-only)
    match /logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidLog(incoming());
      allow update, delete: if false;
    }

    // Opname session and app settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Finance records (Kas, Hutang Mitra, Saldo Santri, Piutang Marhalah)
    match /finance/{financeId} {
      allow read: if true;
      allow write: if isValidId(financeId);
    }

    // Connection verification document
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
